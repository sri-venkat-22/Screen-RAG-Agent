APP_NAME=PGAGI Candidate Screening Engine
API_PREFIX=/api
DATABASE_URL=sqlite:///./backend/data/app.db
VECTOR_STORE_DIR=./backend/data/chroma
KNOWLEDGE_BASE_DIR=./backend/data/knowledge_base
EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKING=true
ENABLE_LOCAL_QUESTION_GENERATION=true
QUESTION_GENERATOR_MODEL_NAME=google/flan-t5-small
INTERVIEW_QUESTION_COUNT=5
RETRIEVAL_TOP_K=4
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
